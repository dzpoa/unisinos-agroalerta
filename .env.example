# Prefixo dos tópicos MQTT — use um valor único do grupo (igual em infra/mosquitto.conf e no firmware)
MQTT_PREFIXO=unisinos-agroalerta
MQTT_HOST=localhost
MQTT_PORTA=1883

# Padrão: SQLite em dados/agroalerta.db. Para PostgreSQL/TimescaleDB, descomente e ajuste:
# DATABASE_URL=postgresql://agro:agro@localhost:5432/agroalerta

# Segredo usado para gerar o ID rotativo diário dos dispositivos (pseudonimização)
SEGREDO_PSEUDONIMO=troque-este-segredo

# Alvo do modelo: chuva >= LIMIAR_MM nas próximas HORIZONTE_H horas
LIMIAR_MM=5.0
HORIZONTE_H=3

# Modelo usado pelo motor de alertas: "vizinhos" (rede colaborativa) ou "local"
CONFIG_MODELO=vizinhos
